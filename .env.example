# Client (Vite). The Worker is same-origin in production.
# Copy to .env.local — never commit values.

# Optional: Vite `/api` proxy target when wrangler is not on 8787.
# POLARCH_WORKER_ORIGIN=http://127.0.0.1:8787

# Offline sample-org build. Do not set for the real app.
# VITE_DEMO=1

# Same-date / off-rhythm occurrence guard. Default OFF in every environment
# (a master merge auto-deploys). Set to 1 only after QA. Worker equivalent:
# SINGLE_OCCURRENCE_GUARD in `.dev.vars` or the Cloudflare dashboard — do not
# put it in wrangler.jsonc vars (keep_vars would not protect a config value).
# VITE_SINGLE_OCCURRENCE_GUARD=1
